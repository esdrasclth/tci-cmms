# Variables que consume docker-compose.yml. Copiar a .env y ajustar.
# El .env de la raiz es solo para Docker; el backend tiene el suyo en backend/.env

POSTGRES_USER=tci
POSTGRES_PASSWORD=tci_dev_password
POSTGRES_DB=tci_cmms
# 5436 y no 5432: evita chocar con un PostgreSQL instalado localmente
POSTGRES_PORT=5436

# Solo se usa por el servicio "backend" (perfil "full") y en produccion.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=cambiar-por-un-secreto-generado
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
