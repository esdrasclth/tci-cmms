# Copiar a .env y ajustar. El .env real NO se versiona.

NODE_ENV=development
PORT=3001

# Base de datos (coincide con docker-compose.yml en la raiz del repo)
DATABASE_URL="postgresql://tci:tci_dev_password@localhost:5436/tci_cmms?schema=public"

# Better Auth — TCI-31
# Generar uno nuevo por ambiente con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="cambiar-por-un-secreto-generado"
BETTER_AUTH_URL="http://localhost:3001"

# Origen del frontend Next.js, para CORS y cookies de sesion
CORS_ORIGIN="http://localhost:3000"

# Ordenes de trabajo — TCI-23
# Exige al menos una evidencia adjunta para poder completar una orden
# (regla 4 de docs/flujo-ordenes.md). Apagado hasta que exista la carga de
# adjuntos (TCI-43): con esto en true ninguna orden podria cerrarse.
EVIDENCIA_OBLIGATORIA=false

# Administrador inicial que crea el seed. El registro publico esta cerrado
# (disableSignUp), asi que sin esto no hay forma de entrar a una instalacion
# nueva. Si la cuenta ya existe, el seed solo le asegura el rol ADMIN.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador TCI"
