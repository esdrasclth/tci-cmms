{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Dentro de dist a proposito: nest-cli borra dist en cada build
    // (deleteOutDir) y si el .tsbuildinfo sobrevive, TypeScript cree que ya
    // emitio todo y deja dist practicamente vacio.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "prisma.config.ts",
    // El seed vive fuera de src y corre con tsx, no con el build de Nest.
    "prisma/seed.ts",
    "vitest.config.mts",
    "vitest.config.e2e.mts"
  ]
}
