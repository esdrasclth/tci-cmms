// CMMS TCI — Esquema de base de datos
// Modelo de Orden de Trabajo definido en TCI-22; estados y flujo en TCI-78.
//
// Alcance de este archivo: los modulos 2 (Ordenes de Trabajo), 3 (Auth),
// 4 (Clientes y Equipos), 6 (Inventario y Repuestos), 7 (Mantenimiento
// Preventivo) y 8 (Notificaciones).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Explicito a proposito: si Prisma no encuentra un tsconfig.json (por ejemplo
  // dentro del build de Docker) emite los imports con extension .ts y el
  // contenedor revienta con "Cannot find module './internal/class.ts'".
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticacion (Better Auth) — TCI-31, TCI-32, TCI-35
// Los modelos User, Session, Account y Verification son el esquema base que
// Better Auth espera. Los campos rol, activo y telefono son propios del CMMS y
// se declaran como additionalFields en src/auth/auth.config.ts.
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  TECNICO
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Campos propios del CMMS
  rol      Rol     @default(TECNICO)
  activo   Boolean @default(true)
  telefono String?

  sessions Session[]
  accounts Account[]

  ordenesAsignadas OrdenTrabajo[]         @relation("TecnicoAsignado")
  ordenesCreadas   OrdenTrabajo[]         @relation("CreadoPor")
  historial        OrdenHistorial[]
  adjuntos         OrdenAdjunto[]
  movimientos      MovimientoInventario[]
  notificaciones   Notificacion[]

  @@index([rol, activo])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  // Better Auth 1.7 identifica la cuenta por (issuer, accountId), no solo por
  // accountId. Es obligatorio.
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Clientes y equipos — TCI-36, TCI-37
// ---------------------------------------------------------------------------

model Cliente {
  id        String    @id @default(cuid())
  nombre    String
  rtn       String?   @unique
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sedes   Sede[]
  equipos Equipo[]
  ordenes OrdenTrabajo[]
  planes  PlanMantenimiento[]

  @@index([activo])
  @@map("clientes")
}

model Sede {
  id            String    @id @default(cuid())
  clienteId     String    @map("cliente_id")
  nombre        String
  direccion     String?
  ciudad        String?
  referenciaGeo String?   @map("referencia_geo")
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  cliente Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  equipos Equipo[]
  ordenes OrdenTrabajo[]

  @@index([clienteId])
  @@map("sedes")
}

/// TCI-49 — catalogo de tipos de equipo.
///
/// Hasta TCI-37 el tipo era texto libre en `Equipo.tipo`. Un plan de
/// mantenimiento colgado de ese campo se rompe en silencio con un plural o una
/// tilde, y los equipos sin tipo no reciben plan y nadie se entera. Al hacerse
/// catalogo, la relacion es una FK y el problema desaparece.
model TipoEquipo {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  equipos Equipo[]
  planes  PlanMantenimiento[]

  @@map("tipos_equipo")
}

model Equipo {
  id              String    @id @default(cuid())
  codigo          String    @unique
  nombre          String
  /// Texto libre heredado de TCI-37. Lo sustituye `tipoEquipoId`; se conserva
  /// para no perder lo que se escribio antes de existir el catalogo.
  tipo            String?
  tipoEquipoId    String?   @map("tipo_equipo_id")
  marca           String?
  modelo          String?
  numeroSerie     String?   @map("numero_serie")
  ubicacionFisica String?   @map("ubicacion_fisica")
  clienteId       String    @map("cliente_id")
  sedeId          String?   @map("sede_id")
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sede       Sede?          @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  tipoEquipo TipoEquipo?    @relation(fields: [tipoEquipoId], references: [id], onDelete: Restrict)
  ordenes    OrdenTrabajo[]

  @@index([clienteId])
  @@index([sedeId])
  @@index([tipoEquipoId])
  @@map("equipos")
}

// ---------------------------------------------------------------------------
// Ordenes de trabajo — TCI-22, TCI-78
// ---------------------------------------------------------------------------

enum OrdenEstado {
  PENDIENTE
  ASIGNADA
  EN_PROCESO
  EN_ESPERA
  COMPLETADA
  CANCELADA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum OrigenOrden {
  MANUAL
  PREVENTIVO_AUTOMATICO
}

// TCI-30: catalogo editable en base de datos, no un enum en codigo.
model TipoMantenimiento {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombre         String
  color          String?
  requiereEquipo Boolean  @default(false) @map("requiere_equipo")
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ordenes OrdenTrabajo[]
  planes  PlanMantenimiento[]

  @@map("tipos_mantenimiento")
}

model OrdenTrabajo {
  id                  String      @id @default(cuid())
  numero              String      @unique
  titulo              String      @db.VarChar(120)
  descripcionProblema String      @map("descripcion_problema")
  trabajoRealizado    String?     @map("trabajo_realizado")
  estado              OrdenEstado @default(PENDIENTE)
  prioridad           Prioridad   @default(MEDIA)
  origen              OrigenOrden @default(MANUAL)

  clienteId           String  @map("cliente_id")
  sedeId              String? @map("sede_id")
  equipoId            String? @map("equipo_id")
  tipoMantenimientoId String  @map("tipo_mantenimiento_id")
  tecnicoId           String? @map("tecnico_id")
  /// De que plan preventivo nacio, si nacio de uno (TCI-50).
  planId              String? @map("plan_id")
  creadoPorId         String  @map("creado_por_id")

  fechaProgramada DateTime? @map("fecha_programada")
  fechaLimite     DateTime? @map("fecha_limite")
  fechaAsignacion DateTime? @map("fecha_asignacion")
  fechaInicio     DateTime? @map("fecha_inicio")
  fechaFin        DateTime? @map("fecha_fin")

  horasTrabajadas Decimal? @map("horas_trabajadas") @db.Decimal(6, 2)
  costoManoObra   Decimal  @default(0) @map("costo_mano_obra") @db.Decimal(12, 2)
  costoRepuestos  Decimal  @default(0) @map("costo_repuestos") @db.Decimal(12, 2)
  costoTotal      Decimal  @default(0) @map("costo_total") @db.Decimal(12, 2)
  moneda          String   @default("HNL") @db.Char(3)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  sede              Sede?              @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  equipo            Equipo?            @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  tipoMantenimiento TipoMantenimiento  @relation(fields: [tipoMantenimientoId], references: [id], onDelete: Restrict)
  tecnico           User?              @relation("TecnicoAsignado", fields: [tecnicoId], references: [id], onDelete: Restrict)
  plan              PlanMantenimiento? @relation(fields: [planId], references: [id], onDelete: SetNull)
  creadoPor         User               @relation("CreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)

  historial   OrdenHistorial[]
  adjuntos    OrdenAdjunto[]
  repuestos   OrdenRepuesto[]
  movimientos MovimientoInventario[]

  @@index([estado])
  @@index([tecnicoId, estado])
  @@index([clienteId])
  @@index([equipoId])
  @@index([fechaProgramada])
  @@index([planId])
  @@index([deletedAt])
  @@map("ordenes_trabajo")
}

// TCI-29: auditoria solo-append. Nunca se edita ni se borra.
enum TipoHistorial {
  CAMBIO_ESTADO
  ASIGNACION
  COMENTARIO
  EDICION
  // TCI-43. Sobre todo por el borrado: al eliminar un adjunto desaparece su
  // fila, y sin este asiento no quedaria rastro de que la evidencia existio.
  ADJUNTO
}

model OrdenHistorial {
  id             String        @id @default(cuid())
  ordenId        String        @map("orden_id")
  usuarioId      String        @map("usuario_id")
  tipo           TipoHistorial
  estadoAnterior OrdenEstado?  @map("estado_anterior")
  estadoNuevo    OrdenEstado?  @map("estado_nuevo")
  campo          String?
  valorAnterior  String?       @map("valor_anterior")
  valorNuevo     String?       @map("valor_nuevo")
  comentario     String?
  createdAt      DateTime      @default(now()) @map("created_at")

  orden   OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario User         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ordenId, createdAt])
  @@map("orden_historial")
}

// TCI-43: evidencia adjunta al cierre.
enum TipoAdjunto {
  EVIDENCIA_ANTES
  EVIDENCIA_DESPUES
  DOCUMENTO
}

model OrdenAdjunto {
  id            String      @id @default(cuid())
  ordenId       String      @map("orden_id")
  usuarioId     String      @map("usuario_id")
  // Clave del objeto en MinIO, no una URL: el bucket es privado y el archivo
  // solo se sirve por la API (GET /ordenes/:id/adjuntos/:adjuntoId), que es
  // donde se comprueba el permiso. Guardar una URL invitaria a repartirla.
  clave         String      @unique
  nombreArchivo String      @map("nombre_archivo")
  mimeType      String      @map("mime_type")
  tamanoBytes   Int         @map("tamano_bytes")
  tipo          TipoAdjunto @default(DOCUMENTO)
  createdAt     DateTime    @default(now()) @map("created_at")

  orden   OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario User         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ordenId])
  @@map("orden_adjuntos")
}

// ---------------------------------------------------------------------------
// Inventario y repuestos — modulo 6 (TCI-45, TCI-46, TCI-47)
//
// El stock vive en dos sitios a proposito: `Repuesto.stockActual` es el saldo
// que leen los listados y las alertas, y `MovimientoInventario` es el libro que
// explica como se llego a el. Se podria derivar el saldo con un SUM en cada
// consulta, pero el listado y el aviso de minimos lo piden en cada pantalla.
//
// El riesgo de esa duplicidad es que las dos versiones se separen, asi que en
// el codigo hay un unico camino que las toca: `InventarioService.mover()`, que
// escribe el asiento y el saldo dentro de la misma transaccion. Nada mas puede
// escribir `stockActual`.
// ---------------------------------------------------------------------------

model Repuesto {
  id           String  @id @default(cuid())
  codigo       String  @unique
  nombre       String
  descripcion  String?
  // Texto y no enum: TCI compra por unidad, litro, metro y kilo, y la lista
  // crecera. Un enum obligaria a migrar la base para anadir una unidad.
  unidadMedida String  @map("unidad_medida") @db.VarChar(12)

  // Tres decimales porque hay consumo fraccionado: 0.750 litros de refrigerante.
  stockActual Decimal @default(0) @map("stock_actual") @db.Decimal(12, 3)
  // TCI-47: por debajo de esto el repuesto entra en la lista de avisos.
  stockMinimo Decimal @default(0) @map("stock_minimo") @db.Decimal(12, 3)

  costoUnitario Decimal @default(0) @map("costo_unitario") @db.Decimal(12, 2)
  moneda        String  @default("HNL") @db.Char(3)

  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  consumos    OrdenRepuesto[]
  movimientos MovimientoInventario[]

  @@index([activo])
  @@map("repuestos")
}

/// Solo dos sentidos. Un ajuste de inventario se registra como la entrada o la
/// salida que corresponda, con su motivo: asi `cantidad` siempre es positiva y
/// el signo lo da el tipo, sin excepciones que recordar.
enum TipoMovimiento {
  ENTRADA
  SALIDA
}

/// Libro de inventario: solo-append, como OrdenHistorial (TCI-29).
model MovimientoInventario {
  id         String  @id @default(cuid())
  repuestoId String  @map("repuesto_id")
  usuarioId  String  @map("usuario_id")
  /// Presente cuando el movimiento nace de consumir en una orden (TCI-46).
  ordenId    String? @map("orden_id")

  tipo            TipoMovimiento
  /// Siempre positiva: el signo lo da `tipo`. Asi no hay que recordar el
  /// convenio al leer una fila suelta.
  cantidad        Decimal        @db.Decimal(12, 3)
  /// Saldo despues del asiento. Redundante con la suma, pero permite auditar
  /// el libro sin recalcularlo entero.
  stockResultante Decimal        @map("stock_resultante") @db.Decimal(12, 3)

  motivo    String?
  createdAt DateTime @default(now()) @map("created_at")

  repuesto Repuesto      @relation(fields: [repuestoId], references: [id], onDelete: Restrict)
  usuario  User          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  orden    OrdenTrabajo? @relation(fields: [ordenId], references: [id], onDelete: SetNull)

  @@index([repuestoId, createdAt])
  @@index([ordenId])
  @@map("movimientos_inventario")
}

/// TCI-46 — que repuestos se usaron en una orden, y cuantos.
model OrdenRepuesto {
  id         String @id @default(cuid())
  ordenId    String @map("orden_id")
  repuestoId String @map("repuesto_id")

  cantidad      Decimal @db.Decimal(12, 3)
  /// Congelado al imputarlo. El precio del catalogo cambia, y el costo de una
  /// orden ya cerrada no puede moverse por detras.
  costoUnitario Decimal @map("costo_unitario") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orden    OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repuesto Repuesto     @relation(fields: [repuestoId], references: [id], onDelete: Restrict)

  /// Una linea por repuesto y orden: si se imputa dos veces, se acumula en la
  /// misma linea. El detalle de cada imputacion queda en el libro.
  @@unique([ordenId, repuestoId])
  @@index([repuestoId])
  @@map("orden_repuestos")
}

// ---------------------------------------------------------------------------
// Mantenimiento preventivo — modulo 7 (TCI-49, TCI-50)
//
// Un plan dice "todo equipo de este tipo lleva este mantenimiento cada N
// unidades de tiempo". La generacion automatica de ordenes es TCI-50; aqui solo
// se define el plan y se lleva la cuenta de cuando toca.
//
// El vencimiento se cuenta **desde el ultimo cierre real**, no desde un
// calendario fijo: si el preventivo de marzo se hizo el 10 de abril, el
// siguiente cuenta desde el 10 de abril. Asi el plan refleja el estado de la
// maquina y no acumula ordenes atrasadas cuando el equipo se retrasa. Decision
// del cliente del 2026-08-26.
// ---------------------------------------------------------------------------

enum UnidadFrecuencia {
  DIAS
  SEMANAS
  MESES
}

model PlanMantenimiento {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?

  /// A que equipos aplica.
  tipoEquipoId String  @map("tipo_equipo_id")
  /// Acota el plan a un cliente. Nulo = todos los equipos de ese tipo.
  clienteId    String? @map("cliente_id")

  /// Con que tipo se levantara la orden generada (normalmente "Preventivo").
  tipoMantenimientoId String @map("tipo_mantenimiento_id")

  frecuenciaValor  Int              @map("frecuencia_valor")
  frecuenciaUnidad UnidadFrecuencia @map("frecuencia_unidad")

  /// Cuantos dias antes del vencimiento se avisa (TCI-52).
  diasAnticipacion Int @default(7) @map("dias_anticipacion")

  /// Prioridad con la que nacen las ordenes de este plan.
  prioridad Prioridad @default(MEDIA)

  /// Instrucciones que se copian a la descripcion de la orden generada.
  instrucciones String?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tipoEquipo        TipoEquipo        @relation(fields: [tipoEquipoId], references: [id], onDelete: Restrict)
  cliente           Cliente?          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoMantenimiento TipoMantenimiento @relation(fields: [tipoMantenimientoId], references: [id], onDelete: Restrict)
  ordenes           OrdenTrabajo[]

  @@index([activo])
  @@index([tipoEquipoId])
  @@map("planes_mantenimiento")
}

// ---------------------------------------------------------------------------
// Notificaciones — modulo 8 (TCI-53, TCI-54, TCI-55, TCI-56)
//
// El canal en vivo (SSE) del que hablaba TCI-53 ya existe desde TCI-42: es
// `GET /ordenes/:id/eventos`. Lo que falta aqui es lo otro que pedia el item,
// que es decidir QUE avisa, A QUIEN y POR DONDE.
//
// Los eventos son un enum de codigo y no un catalogo editable, al reves que los
// tipos de mantenimiento (TCI-30): un evento solo existe si hay una linea de
// codigo que lo emite, asi que dejar crear filas nuevas por pantalla solo
// permitiria inventar eventos que no ocurren nunca. Lo que si es editable es
// todo lo demas: quien lo recibe, por donde y con que texto.
// ---------------------------------------------------------------------------

/// Los eventos que el sistema sabe emitir. Los cuatro primeros son la regla 9
/// de docs/flujo-ordenes.md; los dos ultimos vienen de TCI-47 y TCI-52.
enum EventoNotificable {
  ORDEN_ASIGNADA
  ORDEN_COMPLETADA
  ORDEN_CANCELADA
  ORDEN_REABIERTA
  ORDEN_COMENTADA
  PREVENTIVO_POR_VENCER
  REPUESTO_BAJO_MINIMO
}

/// TCI-54. Sin `PUSH`: las notificaciones push del navegador necesitan service
/// worker, claves VAPID y un almacen de suscripciones por dispositivo, que es
/// infraestructura propia y no una opcion de configuracion. Anadir el valor sin
/// eso solo produciria una casilla que no hace nada.
enum CanalNotificacion {
  EN_APP
  CORREO
}

/// TCI-54 y TCI-55: quien recibe que, y por donde.
///
/// La clave es (evento, rol, canal): la configuracion es por ROL y no por
/// usuario a proposito. Con el tamano de equipo de TCI, preferencias
/// individuales solo servirian para que alguien se desactive los avisos y luego
/// no se entere de su trabajo.
model PreferenciaNotificacion {
  id     String            @id @default(cuid())
  evento EventoNotificable
  rol    Rol
  canal  CanalNotificacion
  activo Boolean           @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([evento, rol, canal])
  @@map("preferencias_notificacion")
}

/// TCI-56: el texto de cada notificacion.
///
/// Editable en base de datos y no fija en codigo porque es contenido: TCI va a
/// querer cambiar como suena un aviso sin esperar a un despliegue. El cuerpo
/// admite marcadores `{{campo}}` que el servicio sustituye.
model PlantillaNotificacion {
  id     String            @id
  evento EventoNotificable @unique

  asunto String
  cuerpo String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plantillas_notificacion")
}

/// La bandeja de cada usuario: donde cae lo que se envia por el canal EN_APP.
///
/// Se guarda el texto ya compuesto y no una referencia a la plantilla: si
/// manana alguien reescribe la plantilla, lo que ya se notifico tiene que
/// seguir diciendo lo que dijo.
model Notificacion {
  id        String            @id @default(cuid())
  usuarioId String            @map("usuario_id")
  evento    EventoNotificable

  titulo String
  cuerpo String
  /// Ruta de la aplicacion a la que lleva. Relativa: el dominio cambia (TCI-70).
  enlace String?

  leidaEn   DateTime? @map("leida_en")
  createdAt DateTime  @default(now()) @map("created_at")

  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leidaEn])
  @@index([usuarioId, createdAt])
  @@map("notificaciones")
}
